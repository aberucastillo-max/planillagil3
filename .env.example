# Copie a .env (local) o cargue estas variables en el panel del hosting. NUNCA suba secretos a Git.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/neondb?sslmode=require
# Orígenes permitidos para el navegador (separados por coma). Agregue el dominio de su frontend publicado.
ALLOWED_ORIGINS=http://localhost:5500,https://cdpn.io,https://codepen.io
